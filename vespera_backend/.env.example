# Vespera backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev, no install required):
DATABASE_URL=sqlite+aiosqlite:///./vespera.db

# PostgreSQL (production — use asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vespera

# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Validate this model ID against https://console.groq.com/docs/models before release.
# Never hardcode a retired model ID (llama3-8b-8192 was retired 2025-08-30).
GROQ_MODEL=llama-3.1-8b-instant

# ── Catalog ──────────────────────────────────────────────────────────────────
JAMENDO_CLIENT_ID=your_jamendo_client_id_here
# Set this only after reading current Jamendo API terms at:
# https://devportal.jamendo.com/api_terms_of_use
JAMENDO_TERMS_CONFIRMED_ON=YYYY-MM-DD

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Dev default: localhost Flutter web port.
# Production: set to your deployed Flutter app URL(s).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ── Legacy Spotify (optional — home/explore feeds) ───────────────────────────
# Leave blank to use YTMusic/YouTube fallback.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# ── Dev flags ────────────────────────────────────────────────────────────────
# Set RELOAD=false in production.
RELOAD=true
PORT=8000
